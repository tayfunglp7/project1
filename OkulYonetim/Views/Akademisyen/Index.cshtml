@model List<OkulYonetim.Models.Akademisyen>
@{
    ViewData["Title"] = "Akademisyenler";
}

@if (TempData["Basarili"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Basarili"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Kayıtlı akademisyenler (@Model.Count)</span>
        <div>
            @* Ekstra puan görevi: CSV dışa aktarma *@
            <a asp-action="CsvIndir" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-download"></i> CSV
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Yeni akademisyen
            </a>
        </div>
    </div>

    <div class="card-body p-0">

        @if (Model.Count == 0)
        {
            @* Boş liste ekranı kullanıcıya NE YAPACAĞINI söylemeli *@
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-3">Henüz akademisyen eklenmemiş.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    İlk akademisyeni ekle
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Ad soyad</th>
                        <th>Bölüm</th>
                        <th>Fakülte</th>
                        <th class="text-center">Yaş</th>
                        <th>TC</th>
                        <th>İletişim</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sira = 1;
                    }

                    @foreach (var akademisyen in Model)
                    {

                        // ── Yaş hesabı ────────────────────────────
                        // Doğum günü bu yıl gelmediyse bir yaş düşülür
                        int yas = DateTime.Today.Year - akademisyen.AkademisyenDogumTarihi.Year;
                        if (akademisyen.AkademisyenDogumTarihi.Date > DateTime.Today.AddYears(-yas))
                        {
                            yas--;
                        }

                        // ── TC maskeleme ──────────────────────────
                        // Kişisel veri; listede tam gösterilmesi gerekmez
                        string tcMaskeli = akademisyen.AkademisyenTc.Length >= 3
                            ? akademisyen.AkademisyenTc.Substring(0, 3) + "********"
                            : "***********";

                        
                        <tr>
                            <td class="text-muted">@sira</td>

                            <td>
                                <a asp-action="Details" asp-route-id="@akademisyen.AkademisyenId"
                                   class="fw-semibold text-decoration-none">
                                    @akademisyen.TamAd
                                </a>
                                <div class="text-muted small">@akademisyen.AkademisyenCinsiyet</div>
                            </td>

                            <td>
                                @* JOIN'den gelen bölüm adı — id değil! *@
                                <span class="badge bg-secondary">@akademisyen.BolumAdi</span>
                            </td>

                            <td class="small text-muted">@akademisyen.FakulteAd</td>

                            <td class="text-center">@yas</td>

                            <td><code class="small">@tcMaskeli</code></td>

                            <td class="small">
                                <div>@akademisyen.AkademisyenTelefon</div>
                                <div class="text-muted">@akademisyen.AkademisyenEposta</div>
                            </td>

                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@akademisyen.AkademisyenId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@akademisyen.AkademisyenId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>

                        sira++;
                    }
                </tbody>
            </table>
        }

    </div>
</div>
