@model List<OkulYonetim.Models.Ogrenci>
@{
    ViewData["Title"] = "Öğrenciler";
}

@if (TempData["Basarili"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Basarili"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Kayıtlı öğrenciler (@Model.Count)</span>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg"></i> Yeni öğrenci
        </a>
    </div>

    <div class="card-body p-0">

        @if (Model.Count == 0)
        {
            @* Boş liste ekranı kullanıcıya NE YAPACAĞINI söylemeli *@
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-3">Henüz öğrenci eklenmemiş.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">
                    İlk öğrenciyi ekle
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Ad soyad</th>
                        <th>Bölüm</th>
                        <th class="text-center">Sınıf</th>
                        <th class="text-center">Yaş</th>
                        <th>TC</th>
                        <th>İletişim</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sira = 1;
                    }

                    @foreach (var ogrenci in Model)
                    {
                        @* ── Yaş hesabı ────────────────────────────────
                           Doğum günü bu yıl henüz gelmediyse bir yaş düşülür *@
                        int yas = DateTime.Today.Year - ogrenci.OgrenciDogumTarihi.Year;
                        if (ogrenci.OgrenciDogumTarihi.Date > DateTime.Today.AddYears(-yas))
                        {
                            yas--;
                        }

                        @* ── TC maskeleme ──────────────────────────
                           Kişisel veri; listede tam gösterilmesi gerekmez.
                           Substring hata vermesin diye önce uzunluk kontrolü. *@
                        string tcMaskeli = ogrenci.OgrenciTc.Length >= 3
                            ? ogrenci.OgrenciTc.Substring(0, 3) + "********"
                            : "***********";

                        <tr>
                            <td class="text-muted">@sira</td>

                            <td>
                                <a asp-action="Details" asp-route-id="@ogrenci.OgrenciId"
                                   class="fw-semibold text-decoration-none">
                                    @ogrenci.TamAd
                                </a>
                                <div class="text-muted small">@ogrenci.OgrenciCinsiyet</div>
                            </td>

                            <td>
                                @* JOIN'den gelen bölüm adı — id değil! *@
                                <span class="badge bg-secondary">@ogrenci.BolumAdi</span>
                            </td>

                            <td class="text-center">
                                <span class="badge bg-info">@ogrenci.OgrenciSinif</span>
                            </td>

                            <td class="text-center">@yas</td>

                            <td><code class="small">@tcMaskeli</code></td>

                            <td class="small">
                                <div>@ogrenci.OgrenciTelefon</div>
                                <div class="text-muted">@ogrenci.OgrenciEposta</div>
                            </td>

                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@ogrenci.OgrenciId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@ogrenci.OgrenciId" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>

                        sira++;
                    }
                </tbody>
            </table>
        }

    </div>
</div>
